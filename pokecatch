#!/usr/bin/env python3
import os
import json
import random
import subprocess
import argparse
import shlex # Used to safely quote file paths
import time #for the delay
import sys


# --- CONFIGURATION ---
# Get the directory where the script is located
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
DATA_FILE = os.path.join(SCRIPT_DIR, 'data', 'pokemon_data.json')
PLAYER_DEX = os.path.join(SCRIPT_DIR, 'data', 'pokedex.json')
SPRITES_DIR = os.path.join(SCRIPT_DIR, 'sprites')
WILD_POKEMON_STATE = os.path.join(SCRIPT_DIR, 'data', 'wild_pokemon.json') # Stores the current wild Pokemon

# Rarity affects catch chance. Lower number = harder to catch.
RARITY_MODIFIERS = {
    "common": 1.0,
    "uncommon": 0.8,
    "rare": 0.6,
    "ultrarare": 0.4,
    "epic": 0.25,
    "legendary": 0.1
}

# Ball multipliers
BALL_MODIFIERS = {
    "poke_ball": 1.0,
    "great_ball": 1.5,
    "ultra_ball": 2.0,
    "master_ball": 100.0 # Effectively a guaranteed catch
}

# Rarity affects spawn chance. Higher number = more likely to appear.
RARITY_SPAWN_WEIGHTS = {
    "common": 100,
    "uncommon": 50,
    "rare": 25,
    "ultrarare": 10,
    "epic": 5,
    "legendary": 1

    #--------mytest-----------#
    # "common": 1,
    # "uncommon": 1,
    # "rare": 1,
    # "ultrarare": 1,
    # "epic": 1,
    # "legendary": 100
}


# --- HELPER FUNCTIONS ---

#helper function to display wild pokemon
def display_sprite(pokemon_name):
    """Displays the pokemon sprite in the Kitty terminal."""
    sprite_path = os.path.join(SPRITES_DIR, f"{pokemon_name}.png")
    if not os.path.exists(sprite_path):
        print(f"Sprite for {pokemon_name} not found!")
        return
    
    #using shlex.quote() to handle filenames with spaces or special characters
    safe_sprite_path = shlex.quote(sprite_path)
    #the full command as a single string
    command = (f"magick {safe_sprite_path} -filter Box -define filter:blur=0.8 -resize 230% -trim png:- | kitty +kitten  icat --stdin=yes --align left")
    try:
        #use shell = True to interepret the pipe
        subprocess.run(command, shell=True, check=True)
        #***old line*** subprocess.run(["kitty", "+icat", "--align", "left","--scale-up", sprite_path], check=True)
        
    except FileNotFoundError:
        print("This game requires the Kitty terminal to display images.")
    except Exception as e:
        print(f"Error displaying image: {e}")

